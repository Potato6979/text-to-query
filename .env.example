# This file is a reference only. The Python application does not load .env files automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
PAIRED_BENCHMARK_NEO4J_DATABASE=pairedbenchmark

# Optional DAIL cache/selector controls.
SQL_DAIL_DISABLE_EXAMPLE_POOL_CACHE=0
SQL_DAIL_EXAMPLE_POOL_CACHE_PATH=
SQL_DAIL_DISABLE_EMBEDDING_CACHE=0
SQL_DAIL_EMBEDDING_CACHE_DIR=
SQL_DAIL_FORCE_BOW=0
